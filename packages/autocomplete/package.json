{
  "name": "@rubenpazch/autocomplete",
  "version": "5.1.4",
  "description": "Autocomplete component",
  "private": false,
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/rubenpazch/lbyte-ui-library.git",
    "directory": "packages/autocomplete"
  },
  "author": "Ruben Paz Chuspe <rubenpazchuspe@outlook.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "@rubenpazch/tokens": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@rubenpazch/icons": "workspace:*",
    "@rubenpazch/loading-spinner": "workspace:*",
    "@rubenpazch/shared": "workspace:*"
  },
  "devDependencies": {
    "@rubenpazch/typescript-config": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "lbyte": {
    "categoria": "formularios",
    "resumen": "Selector con búsqueda sobre una lista de opciones (con descripción, carga y opción de limpiar).",
    "usarCuando": "Elegir un valor entre muchas opciones (más de ~8) o cuando el usuario necesita filtrar escribiendo.",
    "evitarCuando": "Pocas opciones fijas: usa Select o RadioGroup."
  }
}
