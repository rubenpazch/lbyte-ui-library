{
  "name": "@rubenpazch/tokens",
  "version": "0.1.0",
  "repository": "https://github.com/rubenpazch/lbyte-ui-library.git",
  "publishConfig": {
    "access": "public"
  },
  "description": "Design tokens (colors, typography, spacing, radii) — single source of truth for all Lbyte projects",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rubenpazch/eslint-config": "workspace:*",
    "@rubenpazch/typescript-config": "workspace:*",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-typescript2": "^0.37.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
