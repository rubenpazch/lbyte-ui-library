{
  "name": "@rubenpazch/card",
  "version": "0.1.0",
  "description": "Tarjeta con cabecera, cuerpo y pie",
  "repository": {
    "type": "git",
    "url": "https://github.com/rubenpazch/lbyte-ui-library.git",
    "directory": "packages/card"
  },
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@rubenpazch/tokens": "workspace:*",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "dependencies": {
    "@rubenpazch/shared": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rubenpazch/eslint-config": "workspace:*",
    "@rubenpazch/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.37.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "lbyte": {
    "categoria": "presentacion",
    "resumen": "Tarjeta (outlined o elevated) con CardHeader (título, subtítulo, acciones), CardBody y CardFooter; puede ser clicable.",
    "usarCuando": "Agrupar la información de un registro o una sección del panel: resúmenes, KPIs, fichas.",
    "evitarCuando": "Listas largas de registros comparables: usa DataTable."
  }
}
