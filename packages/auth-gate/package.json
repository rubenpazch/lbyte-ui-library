{
  "name": "@rubenpazch/auth-gate",
  "version": "0.2.0",
  "description": "Puerta de sesión: no pinta la app hasta confirmar la sesión con el servidor",
  "repository": {
    "type": "git",
    "url": "https://github.com/rubenpazch/lbyte-ui-library.git",
    "directory": "packages/auth-gate"
  },
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@rubenpazch/tokens": "workspace:*",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "dependencies": {
    "@rubenpazch/shared": "workspace:*"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "lbyte": {
    "categoria": "navegacion",
    "resumen": "Puerta de sesión: comprueba el token, confirma con el servidor (/me) y solo entonces pinta la app; mientras, una pantalla neutra. Sin sesión, va al login sin mostrar nada.",
    "usarCuando": "Raíz de toda app con sesión (paneles, módulos), envolviendo AppShell.",
    "evitarCuando": "Pantallas públicas (login, registro, landing)."
  }
}
