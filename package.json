{
  "name": "@rubenpazch/lbyte-ui-library",
  "version": "1.0.20",
  "private": true,
  "description": "Monorepo for Lbyte UI component library",
  "repository": "https://github.com/rubenpazch/lbyte-ui-library.git",
  "author": "Ruben Paz Chuspe <rubenpazchuspe@outlook.com>",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "lint": "turbo lint",
    "format": "prettier . --write --ignore-path .prettierignore",
    "storybook": "turbo storybook",
    "build-storybook": "pnpm --filter @rubenpazch/storybook run build-storybook",
    "clean": "turbo clean && rm -rf node_modules",
    "release": "changeset publish",
    "generate-package": "node ./scripts/generate-package.js",
    "upgrade:deps": "pnpm -w up --latest",
    "upgrade:interactive": "pnpm -w up",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm test && pnpm build",
    "format:prettier": "prettier . --write --ignore-path .prettierignore",
    "chromatic": "npx chromatic --project-token=chpt_998c11915f82eae"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "postcss-svgo": "7.1.0",
      "test-exclude": "7.0.1",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "typescript": "6.0.3",
      "eslint": "9.39.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@changesets/cli": "^3.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rubenpazch/eslint-config": "workspace:^",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "babel-jest": "^30.5.0",
    "chromatic": "^18.7.1",
    "eslint-plugin-storybook": "^10.5.10",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "lint-staged": "^17.4.1",
    "lodash": "4.18.1",
    "turbo": "^2.10.12",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@rubenpazch/icons": "workspace:^"
  }
}
